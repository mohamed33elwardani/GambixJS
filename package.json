{
  "name": "gambixjs",
  "description": "GAMBIXJS — dependency-free chessboard UI library (drag/click, arrows, highlights, promotion, animations, plugins)",
  "version": "1.1.0",
  "license": "MIT",
  "author": "Mohamed Mustafa EL-Wardani",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamed33elwardani/GambixJS.git"
  },
  "homepage": "https://gambixjs.vercel.app",
  "bugs": {
    "url": "https://github.com/mohamed33elwardani/GambixJS/issues"
  },
  "keywords": [
    "chess",
    "chessboard",
    "ui",
    "javascript",
    "typescript",
    "gambix"
  ],
  "type": "module",
  "main": "dist/bundle.js",
  "module": "dist/bundle.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle.js",
      "default": "./dist/bundle.js"
    },
    "./style.css": "./dist/bundle.css"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:js",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly --declarationMap false",
    "build:js": "esbuild ts/index.ts --bundle --outfile=dist/bundle.js --minify --format=esm",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run verify",
    "dev": "esbuild ts/index.ts --bundle --outfile=dist/bundle.js --format=esm --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/verify-package.mjs",
    "test:browser": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:package && npm run test:browser"
  },
  "files": [
    "dist",
    "docs"
  ],
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^3.0.3",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^2.1.9"
  }
}
